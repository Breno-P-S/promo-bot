# Banco / fila
DATABASE_URL="postgresql://postgres:senha@localhost:5432/promobot"
REDIS_URL="redis://localhost:6379"

# Telegram
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_USERBOT_SESSION=""
TELEGRAM_BOT_TOKEN=""

# WhatsApp
WHATSAPP_ENABLED="false"
WHATSAPP_SESSION_PATH="./sessions/whatsapp"

# Painel administrativo
ADMIN_JWT_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
ADMIN_PORT=3001
ADMIN_HOST="127.0.0.1"
ADMIN_INITIAL_EMAIL="admin@promobot.local"
# Opcional. Se vazio, o seed gera uma senha aleatória e mostra uma vez.
ADMIN_INITIAL_PASSWORD=""

# Processamento
REVISAO_MANUAL_ATIVA="true"
DEDUP_WINDOW_HOURS=24
TMP_MEDIA_MAX_AGE_DAYS=7
CONFIANCA_MINIMA_SEM_REVISAO=95
WORKER_CONCURRENCY=3
TELEGRAM_POLL_INTERVAL_MS=180000

# Chromium compartilhado por Mercado Livre + Amazon
BROWSER_PROFILE_PATH="./sessions/browser"
# Obrigatório se o Chromium não estiver em um caminho padrão.
# Exemplo Windows:
# BROWSER_EXECUTABLE="C:\\Users\\SEU_USUARIO\\AppData\\Local\\Chromium\\Application\\chrome.exe"
BROWSER_EXECUTABLE=""

# Afiliados
ML_AFFILIATE_TAG=""
AMAZON_AFFILIATE_TAG=""

NODE_ENV="development"
LOG_LEVEL="info"
